  {
    "id": "ming-zheng-yan-shun",
    "text": "名正言顺",
    "pinyin": "míng zhèng yán shùn",
    "kind": "chengyu",
    "frequency": 2,
    "sentiment": "positive",
    "register": "neutral",
    "themes": [
      "conduct",
      "leadership-and-authority",
