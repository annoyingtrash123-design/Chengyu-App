    ],
    "literal": "name · correct · words · smooth",
    "natural": "legitimate",
    "meaning": {
      "en": "Fully justified and legitimate.",
      "zh": "名义正当，道理也讲得通。"
    },
    "equivalents": [
      "legitimate",
      "justified",
      "above board"
    ],
    "examples": [
      {
        "zh": "有了正式任命，他就名正言顺地开展工作了。",
        "en": "With his formal appointment, he could get on with the job legitimately."
      },
      {
        "zh": "这样做名正言顺，谁也挑不出毛病。",
        "en": "Doing it this way is fully justified; no one can fault it."
      }
    ],
    "origin": {
      "source": "《论语·子路》",
      "story": {
        "en": "Confucius: 'If names are not correct, speech will not flow; if speech does not flow, affairs will not succeed' (名不正，则言不顺；言不顺，则事不成).",
        "zh": "《论语》：“名不正，则言不顺；言不顺，则事不成。”"
      },
      "date": {
        "zh": "战国初 · 前5—前4世纪",
        "en": "early Warring States, 5th–4th c. BC"
      }
    },
    "usage": {
      "en": "Adverbial or predicate.",
      "zh": "多作状语、谓语。"
    },
    "synonyms": [
      "理所当然",
      "光明正大",
      "师出有名"
    ],
    "antonyms": [
      "名不正言不顺",
      "师出无名"
    ]
  },
