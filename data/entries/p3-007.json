  {
    "id": "he-er-bu-tong",
    "text": "和而不同",
    "pinyin": "hé ér bù tóng",
    "kind": "chengyu",
    "frequency": 2,
    "sentiment": "positive",
    "register": "formal",
    "themes": [
      "positive-character-qualities",
      "confucian-classics",
      "pre-qin"
    ],
    "literal": "harmonious · yet · not · same",
    "natural": "harmony without uniformity",
    "meaning": {
      "en": "To live in harmony with others without blindly agreeing with them.",
      "zh": "与人和睦相处，但不盲目附和。"
    },
    "equivalents": [
      "harmony without uniformity",
      "agree to differ",
      "unity in diversity"
    ],
    "examples": [
      {
        "zh": "团队合作要和而不同，敢于提出不同意见。",
        "en": "Good teamwork means harmony without uniformity: daring to voice a different view."
      },
      {
        "zh": "各国文化应当和而不同、相互尊重。",
        "en": "Different cultures should coexist in harmony while respecting their differences."
      }
    ],
    "origin": {
      "source": "《论语·子路》",
      "story": {
        "en": "Confucius: 'The gentleman seeks harmony but not sameness; the petty man seeks sameness but not harmony.'",
        "zh": "《论语》：“君子和而不同，小人同而不和。”"
      },
      "date": {
        "zh": "战国初 · 前5—前4世纪",
        "en": "early Warring States, 5th–4th c. BC"
      }
    },
    "usage": {
      "en": "Predicate or object; formal, common in essays and diplomacy.",
      "zh": "多作谓语、宾语，常用于议论文和外交辞令。"
    },
    "synonyms": [
      "求同存异"
    ],
    "antonyms": [
      "党同伐异",
      "随声附和",
      "人云亦云",
      "同流合污"
    ]
  },
