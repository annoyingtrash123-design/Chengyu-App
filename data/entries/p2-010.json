      }
    },
    "usage": {
      "en": "Originally Buddhist: a bodhisattva appearing in many forms to teach.",
      "zh": "原为佛教语，指佛现出各种身形说法。"
    },
    "synonyms": [
      "以身作则"
    ],
    "antonyms": [
      "纸上谈兵"
    ]
