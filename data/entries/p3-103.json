  {
    "id": "miu-yi-qian-li",
    "text": "谬以千里",
    "pinyin": "miù yǐ qiān lǐ",
    "kind": "chengyu",
    "frequency": 2,
    "sentiment": "negative",
    "register": "formal",
    "themes": [
      "mistakes-and-correction",
      "relative-measurements",
      "confucian-classics",
      "qin-han"
    ],
    "literal": "error · by · thousand · li",
    "natural": "off by a thousand miles",
    "meaning": {
      "en": "A small initial error leads to a huge deviation.",
      "zh": "开始时一点小差错，结果造成很大的错误。"
    },
    "equivalents": [
      "a small slip leads to a huge error",
      "miss by a mile"
    ],
    "examples": [
      {
        "zh": "失之毫厘，谬以千里，细节不能马虎。",
        "en": "A tiny slip can become a huge error; details matter."
      },
      {
        "zh": "方向选错了，只会谬以千里。",
        "en": "With the wrong direction, you will end up miles off."
      }
    ],
    "usage": {
      "en": "Usually 差之毫厘，谬以千里.",
      "zh": "常说“差之毫厘，谬以千里”。"
    },
    "synonyms": [
      "大相径庭",
      "大错特错",
      "差之毫厘，谬以千里",
      "大谬不然"
    ],
    "antonyms": [
      "分毫不差",
      "毫厘不差"
    ],
    "origin": {
      "source": "《礼记·经解》",
      "story": {
        "en": "The Record of Rites quotes the Changes: 'The gentleman is careful at the start; a difference of a hair becomes an error of a thousand li' (差若毫厘，缪以千里). 谬以千里 condenses it.",
        "zh": "《礼记·经解》引《易》曰：“君子慎始，差若毫厘，缪以千里。”后作“谬以千里”。"
      },
      "date": {
        "zh": "西汉 · 前1世纪",
        "en": "Western Han, 1st c. BC"
      }
    }
  },
