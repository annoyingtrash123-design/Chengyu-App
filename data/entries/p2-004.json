[
  {
    "id": "e-xing-xun-huan",
    "text": "恶性循环",
    "pinyin": "è xìng xún huán",
    "kind": "phrase",
    "frequency": 1,
    "modern": "borrowed",
    "sentiment": "negative",
    "register": "neutral",
    "themes": [
      "chain-reactions",
      "natural-consequences"
    ],
    "literal": "malignant · cycle",
    "natural": "vicious circle",
    "meaning": {
      "en": "A cycle in which problems keep making each other worse.",
      "zh": "坏结果与坏原因互相影响，越来越坏。"
    },
    "equivalents": [
      "vicious circle",
      "downward spiral"
    ],
    "examples": [
      {
        "zh": "熬夜、疲劳、效率低，形成了恶性循环。",
        "en": "Staying up late, tiredness and low efficiency form a vicious circle."
      },
      {
        "zh": "要打破贫困的恶性循环。",
        "en": "We must break the vicious circle of poverty."
      },
      {
        "zh": "越焦虑越睡不着，越睡不着越焦虑，真是恶性循环。",
        "en": "The more anxious, the less sleep; the less sleep, the more anxious — a real vicious circle."
      }
    ],
    "usage": {
      "en": "Usually 形成/陷入/打破恶性循环. Opposite 良性循环.",
      "zh": "常说“形成（陷入、打破）恶性循环”，反义“良性循环”。"
    },
    "synonyms": [],
    "antonyms": [
      "良性循环"
    ]
  },
