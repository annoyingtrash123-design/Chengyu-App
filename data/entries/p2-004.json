  {
    "id": "zai-jie-zai-li",
    "text": "再接再厉",
    "pinyin": "zài jiē zài lì",
    "kind": "chengyu",
    "frequency": 1,
    "sentiment": "positive",
    "register": "neutral",
    "themes": [
      "effort",
      "essay-favourites",
      "poems-prose",
      "sui-tang-wudai"
    ],
    "literal": "again · engage · again · sharpen",
    "natural": "keep up the good work",
    "meaning": {
      "en": "To keep striving and do even better.",
      "zh": "一次又一次地继续努力。"
    },
    "equivalents": [
      "keep up the good work",
      "build on one's success",
      "keep at it"
    ],
    "examples": [
      {
        "zh": "这次考得不错，希望你再接再厉。",
        "en": "Good result this time — keep up the good work."
      },
      {
        "zh": "球队再接再厉，又赢了一场。",
        "en": "The team kept it up and won another match."
      }
    ],
    "origin": {
      "source": "韩愈、孟郊《斗鸡联句》",
      "story": {
        "en": "In a linked verse on cockfighting, Han Yu describes a cock that, sprayed with water to revive it, 'sharpens its beak and engages again' (再接再砺乃). 砺 'whetstone' later became 厉.",
        "zh": "韩愈、孟郊《斗鸡联句》：“一喷一醒然，再接再砺乃。”写斗鸡磨嘴再战，“砺”后写作“厉”。"
      },
      "date": {
        "zh": "唐 · 约806年",
        "en": "Tang dynasty, c. 806"
      }
    },
    "usage": {
      "en": "Often as encouragement after success. Not 再接再励.",
      "zh": "常用于成功后的鼓励。注意不写作“再接再励”。"
    },
    "synonyms": [
      "精益求精",
      "乘胜追击",
      "革命尚未成功，同志仍须努力",
      "百尺竿头，更进一步"
    ],
    "antonyms": [
      "半途而废",
      "一蹶不振",
      "前功尽弃"
    ],
    "variants": [
      "再接再砺"
    ]
  },
